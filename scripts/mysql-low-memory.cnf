# Optional starting profile for the small CareConnect demo on a shared 1 GiB VPS.
# Install as /etc/mysql/mysql.conf.d/zz-careconnect-memory.cnf before startup.
# These settings reduce allocations; they do not impose a hard process RAM cap.
[mysqld]
innodb_buffer_pool_size = 64M
innodb_log_buffer_size = 8M
key_buffer_size = 8M
max_connections = 20
table_open_cache = 128
table_definition_cache = 400
tmp_table_size = 16M
max_heap_table_size = 16M
temptable_max_ram = 32M
# Keep Performance Schema enabled: the setup script queries its TLS channel.
